# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Render Postgres connection string (ssl is included on Render)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reetroz
# Public R2 / CDN prefix for covers, pages, manifests. Production: https://assets.reetroz.com
NEXT_PUBLIC_ASSET_BASE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional community invites (or paste URLs in src/lib/community.ts)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
