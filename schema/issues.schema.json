{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reetroz.local/schema/issues.schema.json",
  "title": "Issues",
  "description": "All issues of one publication (schema.org PublicationIssue). Stored at library/<publication>/issues.json, chronological order.",
  "type": "array",
  "items": { "$ref": "#/$defs/issue" },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "relPath": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$", "description": "Path relative to the repository root, forward slashes" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publication", "sequence", "number", "date", "pages", "source", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "<publication>-<number with . replaced by ->, e.g. cgw-186, cgw-1-1. Used in URLs and folder names"
        },
        "publication": { "type": "string", "description": "publication id" },
        "sequence": { "type": "integer", "minimum": 1, "description": "Chronological position within the publication, 1-based. Drives prev/next and sorting" },
        "number": { "type": "string", "description": "Issue number as printed: 186, 1.1, Premiere, Holiday" },
        "volume": { "type": "integer", "minimum": 1 },
        "issue_in_volume": { "type": "integer", "minimum": 1 },
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "start", "precision"],
          "properties": {
            "display": { "type": "string", "description": "As printed on the cover: Nov-Dec 1981, Holiday 1999, Jan 2000" },
            "start": { "$ref": "#/$defs/isoDate" },
            "end": { "$ref": "#/$defs/isoDate", "description": "For bimonthly / seasonal issues" },
            "precision": { "type": "string", "enum": ["day", "month", "season", "year"] }
          }
        },
        "special": { "type": "string", "description": "Anniversary, awards issue, premiere, final issue ..." },
        "cover_headline": { "type": "string", "description": "Main cover line, useful for search and shelves" },
        "pages": { "type": "integer", "minimum": 1 },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width_mm": { "type": "number" },
            "height_mm": { "type": "number" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "url"],
          "properties": {
            "provider": { "type": "string", "description": "provider id" },
            "url": { "type": "string", "format": "uri", "description": "Page or direct file the scan was taken from" },
            "external_id": { "type": "string", "description": "Provider's own id (IA identifier, museum id)" },
            "retrieved_at": { "type": "string", "format": "date-time" },
            "scan_credit": { "type": "string", "description": "Uploader / scanner to credit, if known" }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pdf"],
          "properties": {
            "pdf": { "$ref": "#/$defs/relPath" },
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "has_text_layer": { "type": "boolean", "description": "PDF already contains OCR text" }
          }
        },
        "assets": {
          "type": "object",
          "description": "Generated by scripts/build_pages.py",
          "additionalProperties": false,
          "properties": {
            "cover": { "$ref": "#/$defs/relPath" },
            "pages_rendered": { "type": "boolean" },
            "manifest": { "$ref": "#/$defs/relPath" }
          }
        },
        "text": {
          "type": "object",
          "description": "Searchable text status",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["none", "embedded", "ocr", "external"], "description": "embedded = from PDF text layer; ocr = we ran it; external = fetched from provider (e.g. IA hOCR)" },
            "engine": { "type": "string", "description": "e.g. ABBYY FineReader 11, tesseract 5.3, paddleocr 3.0" },
            "path": { "$ref": "#/$defs/relPath", "description": "Per-page text + boxes file" },
            "languages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "contents": {
          "type": "array",
          "description": "Table of contents, filled later by extraction",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "page"],
            "properties": {
              "title": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 },
              "kind": { "type": "string", "enum": ["review", "preview", "feature", "column", "news", "letters", "strategy", "ad", "other"] },
              "games": { "type": "array", "items": { "type": "string" } },
              "score": { "type": "string", "description": "Review score as printed, e.g. 4.5/5, 92%" }
            }
          }
        },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "rights": {
          "type": "object",
          "description": "Override of the publication's rights for this issue only",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["authorized", "community-scan", "link-only", "public-domain", "removed"] },
            "note": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
